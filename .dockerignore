# Secrets -- never bake a real key into an image layer.
.env
.env.local
*.key

# Python
**/__pycache__/
**/*.py[cod]
backend/.venv/
**/*.egg-info/
**/.pytest_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/

# Node / frontend (installed and built fresh inside the image instead)
frontend/node_modules/
frontend/dist/
**/.vite/

# Generated / cached artifacts
backend/.tts_cache/
backend/tests/.scratch/

# VCS / editor / docs -- irrelevant to what actually runs
.git/
.claude/
.idea/
.vscode/
*.md
docs/
# Exception: extractor.md is a real runtime asset (llm/prompt_builder.py
# reads it from disk via Path(__file__).parent / "prompts" / "extractor.md"
# at import time, not embedded in code), not documentation -- the bare
# "*.md" rule above matches recursively (confirmed against Docker's own
# .dockerignore docs, not assumed), so without this negation the deployed
# image would build and pass /api/health fine, then raise FileNotFoundError
# on the very first real conversational turn that reaches the extractor.
# Must come after "*.md": the last matching pattern wins.
!backend/app/llm/prompts/*.md
