# Secrets -- never bake a real key into an image layer.
.env
.env.local
*.key

# Python
**/__pycache__/
**/*.py[cod]
backend/.venv/
**/*.egg-info/
**/.pytest_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/

# Node / frontend (installed and built fresh inside the image instead)
frontend/node_modules/
frontend/dist/
**/.vite/

# Generated / cached artifacts
backend/.tts_cache/
backend/tests/.scratch/

# VCS / editor / docs -- irrelevant to what actually runs
.git/
.claude/
.idea/
.vscode/
*.md
docs/
