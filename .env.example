# Groq powers speech-to-text and the LLM.
# One key, server-side only. Never expose this to the browser.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me

# Cartesia powers text-to-speech. A separate key, also server-side only.
# Get one (free, no card required) at https://play.cartesia.ai/keys
# Why not Groq's own Orpheus TTS: its free tier is 3600 tokens/day, confirmed
# live to exhaust from ordinary development testing alone -- see MASTER_PLAN.md.
CARTESIA_API_KEY=sk_car_replace_me

# --- Model selection (defaults are the recommended production-tier models) ---
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
CARTESIA_TTS_MODEL=sonic-latest
CARTESIA_TTS_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4

# --- Behaviour ---
# Sessions are held in memory and swept after this many seconds of inactivity.
SESSION_TTL_SECONDS=3600
# Max clarification attempts per field before the value is accepted with a noted assumption.
MAX_CLARIFY_ATTEMPTS=2
# Directory for pre-synthesised TTS audio (gitignored, regenerated on demand).
TTS_CACHE_DIR=.tts_cache

# --- Local dev ---
LOG_LEVEL=INFO
